<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.WindowsLockPinCompanion" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/accent</item>
        <!-- Deep Crystal Navy Status Bar and Navigation Bar -->
        <item name="android:statusBarColor">@color/status_bar_navy</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/status_bar_navy</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:windowBackground">@color/window_dark_bg</item>
    </style>
</resources>
